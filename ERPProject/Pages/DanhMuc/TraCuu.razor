@page "/Dm_TraCuu"
@using DAO.Models.DanhMuc
@using DAO.Services.XuatExcel;
@using DAO.ViewModel;
@using ERPProject.Shared.Combobox;
@inherits TraCuuBase
@inject NavigationManager NavigationManager
@inject IJSRuntime IJSRuntime
<style type="text/css">
    #gdv > div.e-gridcontent > div {
        max-height: calc(100vh - 185px) !important;
    }

    .scrollable-table {
        width: 100%;
        height: 100%; /* Adjust the height as needed */
        overflow: auto; /* Enable both horizontal and vertical scrolling */
    }

    .heading-col {
        background-color: #00676B;
        color: #fff;
        text-align: center;
        border: 1px solid #333;
    }

    .row-style {
        border: 1px solid #333;
        text-align: center;
    }

    .ml {
        margin-left: 15px;
    }

    .e-rowcell.e-attr {
        position: sticky;
        top: 0;
        left: 0;
        border-right: 0.5px solid #DEE2E6;
        border-left: 0.5px solid #DEE2E6;
        /*z-index: 99999;*/
    }

    .e-columnheader:first-child .e-headercell:nth-child(2) {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 1;
    }

    .e-row:nth-of-type(odd) .e-rowcell.e-attr {
        background: #F9F9F9;
    }

    .e-row:nth-of-type(even) .e-rowcell.e-attr {
        background: white;
    }

    .e-multiselect {
        margin-right: 5px;
    }

    .e-grid .e-summaryrow .e-summarycell {
        width: 1% !important;
    }

    .e-grid.sf-grid .e-table .e-summaryrow td:nth-child(2) {
        width: 80% !important;
    }

    tfoot > tr td:nth-child(2) {
        width: 80% !important;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        padding: 5px 0;
    }

    .col {
        flex: 1; /* Mỗi cột sẽ chiếm đầy đủ không gian có thể */
        min-width: 300px; /* Đảm bảo rằng nó không nhỏ hơn 300px */
        padding-bottom: 5px;
    }

    .title {
        display: block;
        margin-bottom: 5px;
    }
</style>

<BodyCard>
    <SfToolbar>
        <ToolbarItems>
            @* <ToolbarItem Type="ItemType.Button">
            <Template>
            <SfButton CssClass="e-flat" IconCss="icon-loop3" @onclick="onTaiLai">Xem dữ liệu</SfButton>
            </Template>
            </ToolbarItem>
            <ToolbarItem Type="ItemType.Separator">
            </ToolbarItem>

            <ToolbarItem Type="ItemType.Button">
            <Template>
            <SfButton CssClass="e-flat e-info" IconCss="icon-file-excel" @onclick="onXuatExcel">Xuất excel</SfButton>
            </Template>
            </ToolbarItem>*@
            <div class="row">
                <div class="col" style="padding-bottom: 10px;">
                    <span class="title">Chọn chi nhánh:</span>
                    <CbMultiChiNhanh @ref="CbChiNhanh" Width="300px" PopupWidth="100%" OnDataSent="ValueChangeHandler"></CbMultiChiNhanh>
                </div>
                <div class="col" style="padding-bottom: 10px;">
                    <span class="title">Chọn Trạm:</span>
                    <CbMultiTram @ref="CbTram" Width="300px" PopupWidth="100%" Data="prcTrams" OnDataSent="ValueChangeHandler1"></CbMultiTram>
                </div>
                <div class="col" style="padding-bottom: 10px;">
                    <span class="title">Chọn thông số:</span>
                    <CbMultiThongSo @ref="CbThongSo" Width="300px" PopupWidth="100%" Data1="prcThongSos"></CbMultiThongSo>
                </div>
            </div>
            <div class="row">
                <div class="col" style="padding-bottom: 10px;">

                    <span class="title">Từ ngày</span>
                    <SfDatePicker TValue="DateTime" @bind-Value="StartDate" Format="dd/MM/yyyy" Width="300px"></SfDatePicker>

                </div>

                <div class="col" style="padding-bottom: 10px;">
                    <span class="title">Đến ngày</span>
                    <SfDatePicker TValue="DateTime" @bind-Value="EndDate" Format="dd/MM/yyyy" Width="300px"></SfDatePicker>

                </div>
                <div class="col" style="padding-bottom: 10px;">

                    <span class="title">Chọn thời gian</span>
                    <CbTime @ref="CbThoiGian" PopupWidth="100%" Width="300px" Value="Index"></CbTime>

                </div>
            </div>

            <div class="col">
                <ToolbarItem Type="ItemType.Button">
                    <Template>
                        <SfButton CssClass="e-flat" IconCss="icon-loop3" @onclick="onTaiLai">Xem dữ liệu</SfButton>
                    </Template>
                </ToolbarItem>
                <ToolbarItem Type="ItemType.Separator"></ToolbarItem>
                <ToolbarItem Type="ItemType.Button">
                    <Template>
                        <SfButton CssClass="e-flat e-info" IconCss="icon-file-excel" @onclick="onXuatExcel">Xuất excel</SfButton>
                    </Template>
                </ToolbarItem>
            </div>



        </ToolbarItems>
        @* <div class="d-flex align-items-center">
        <div class="ml mt-2 mb-1">
        <span>Từ ngày</span>
        <SfDatePicker TValue="DateTime" @bind-Value="StartDate" Format="dd/MM/yyyy" Width="200px"></SfDatePicker>

        </div>

        <div class="ml mt-2 mb-1">
        <span>Đến ngày</span>
        <SfDatePicker TValue="DateTime" @bind-Value="EndDate" Format="dd/MM/yyyy" Width="200px"></SfDatePicker>
        <CbTime @ref="CbThoiGian" PopupWidth="100%" Width="220px" Value="Index"></CbTime>
        </div>
        </div>
        *@
    </SfToolbar>

    <SfGrid DataSource="@data" AllowResizing="true"Width="1200" Height="500">
        <GridColumns>
            <GridColumn Field="TT" TextAlign="TextAlign.Center" HeaderText="TT" Width="50" Freeze="FreezeDirection.Left" ></GridColumn>
            <GridColumn Field="ThoiGian" Format="dd/MM/yyyy" TextAlign="TextAlign.Center" HeaderText="Ngày" Width="120"  CustomAttributes=@(new Dictionary<string, object>() { { "class", "e-attr" } })></GridColumn>
            <GridColumn Field="ThoiGian" Format="HH:mm:ss" TextAlign="TextAlign.Center" HeaderText="Thời gian" Width="120"  CustomAttributes=@(new Dictionary<string, object>() { { "class", "e-attr" } })></GridColumn>

            @if (ListNhatKy != null)
            {
                var listTram = ListNhatKy.GroupBy(x => x.TenTram).Distinct();
                @foreach (var list in listTram)
                {
                    var asx = list.OrderByDescending(x => x.Thoi_Gian).FirstOrDefault();
                    var time = new DateTime();
                    if (asx != null)
                    {
                        time = asx.Thoi_Gian;
                    }
                    var items = list.Where(x => x.Thoi_Gian == time).ToList();
                    <GridColumn HeaderText="@list.Key" TextAlign="TextAlign.Center" Width="300">
                        <GridColumns>
                            @foreach (var item in items)
                            {
                                <GridColumn HeaderText="@item.TenThongSo" TextAlign="TextAlign.Center" Width="150">
                                    <Template>
                                        @{
                                            string tenTramThongSo = list.Key + item.TenThongSo;
                                            int index = ListSum.FindIndex(x => x.TenThongSo == tenTramThongSo);
                                            var cx = context as BaoCaoTraCuuViewModel;
                                            var gt = list.FirstOrDefault(x => x.Thoi_Gian == cx.ThoiGian && x.Id_ThongSo == item.Id_ThongSo);
                                            if (gt != null)
                                            {
                                                <div>@gt.Gia_Tri</div>

                                                decimal giaTri = decimal.Parse(@gt.Gia_Tri); //decimal.Parse(item.Gia_Tri)

                                                if (index >= 0)
                                                {
                                                    ListSum[index].TongGiaTriThongSo += giaTri;
                                                    ListSum[index].CountGiaTriThongSo++;
                                                    ListSum[index].AvrGiaTriThongSo = Math.Round(ListSum[index].TongGiaTriThongSo / ListSum[index].CountGiaTriThongSo, 1);

                                                    if (ListSum[index].MinGiaTriThongSo > giaTri)
                                                    {
                                                        ListSum[index].MinGiaTriThongSo = giaTri;
                                                    }
                                                    if (ListSum[index].MaxGiaTriThongSo < giaTri)
                                                    {
                                                        ListSum[index].MaxGiaTriThongSo = giaTri;
                                                    }

                                                }
                                                else
                                                {
                                                    ListSum.Add(new ChiTietViewModel
                                            {
                                                TenThongSo = tenTramThongSo,
                                                TongGiaTriThongSo = giaTri,
                                                MinGiaTriThongSo = giaTri,
                                                MaxGiaTriThongSo = giaTri,
                                                AvrGiaTriThongSo = giaTri,
                                            });
                                                }
                                            }
                                            else
                                            {
                                                <div>--</div>
                                            }

                                        }
                                    </Template>
                                </GridColumn>
                                @if (item.TenThongSo == "TỔNG LƯU LƯỢNG 1" || item.TenThongSo == "TỔNG LƯU LƯỢNG 2" || item.TenThongSo == "TỔNG LƯU LƯỢNG 3" || item.TenThongSo == "TỔNG LƯU LƯỢNG 4" || item.TenThongSo == "TỔNG LƯU LƯỢNG 5" || item.TenThongSo == "ÁP LỰC 2"
                               )
                                {
                                    <GridColumn HeaderText="Tiêu thụ" TextAlign="TextAlign.Center" Width="150">
                                        <Template>
                                            @{
                                                string tenTramTieuThu = list.Key + item.TenThongSo + "Tiêu thụ";
                                                string tenTramThongSo = list.Key + item.TenThongSo;
                                                int index = ListSum.FindIndex(x => x.TenThongSo == tenTramThongSo);
                                                var cx = context as BaoCaoTraCuuViewModel;

                                                if (CbThoiGian.Value == 1)
                                                {
                                                    var currentGt = list.FirstOrDefault(x => x.Thoi_Gian == cx.ThoiGian && x.Id_ThongSo == item.Id_ThongSo);
                                                    var fiveMinutesBeforeGt = list.FirstOrDefault(x => x.Thoi_Gian == cx.ThoiGian.AddMinutes(-5) && x.Id_ThongSo == item.Id_ThongSo);

                                                    if (currentGt != null && fiveMinutesBeforeGt != null)
                                                    {
                                                        decimal currentGtValue = decimal.Parse(currentGt.Gia_Tri);
                                                        decimal fiveMinutesBeforeGtValue = decimal.Parse(fiveMinutesBeforeGt.Gia_Tri);
                                                        decimal difference = currentGtValue - fiveMinutesBeforeGtValue;

                                                        <div>@difference</div>

                                                        if (index >= 0)
                                                        {
                                                            ListSum[index].TongGiaTriTieuThu += difference;
                                                            ListSum[index].CountGiaTriTieuThu++;
                                                            ListSum[index].AvrGiaTriTieuThu = Math.Round(ListSum[index].TongGiaTriTieuThu / ListSum[index].CountGiaTriTieuThu, 1);

                                                            if (ListSum[index].MinGiaTriTieuThu > difference)
                                                            {
                                                                ListSum[index].MinGiaTriTieuThu = difference;
                                                            }
                                                            if (ListSum[index].MaxGiaTriTieuThu < difference)
                                                            {
                                                                ListSum[index].MaxGiaTriTieuThu = difference;
                                                            }
                                                        }
                                                        else
                                                        {
                                                            ListSum.Add(new ChiTietViewModel
                                                {
                                                    TenThongSo = tenTramTieuThu,
                                                    TongGiaTriTieuThu = difference,
                                                    MinGiaTriTieuThu = difference,
                                                    MaxGiaTriTieuThu = difference,
                                                    AvrGiaTriTieuThu = difference,
                                                });
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div>--</div>
                                                    }
                                                }
                                                if (CbThoiGian.Value == 2)
                                                {
                                                    var startDate = StartDate.Date;  // Assuming StartDate is a DateTime property bound to your date picker

                                                    if (cx.ThoiGian.Date == startDate && cx.ThoiGian.Hour == 0 && cx.ThoiGian.Minute == 0)
                                                    {
                                                        <div>--</div>
                                                        // Display "--" for the first hour of the start date
                                                    }
                                                    else
                                                    {
                                                        var currentHourGt = list.FirstOrDefault(x => x.Thoi_Gian.Date == cx.ThoiGian.Date && x.Thoi_Gian.Hour == cx.ThoiGian.Hour && x.Thoi_Gian.Minute == 0 && x.Id_ThongSo == item.Id_ThongSo);
                                                        var previousHourGt = list.FirstOrDefault(x => x.Thoi_Gian.Date == cx.ThoiGian.AddHours(-1).Date && x.Thoi_Gian.Hour == cx.ThoiGian.AddHours(-1).Hour && x.Thoi_Gian.Minute == 0 && x.Id_ThongSo == item.Id_ThongSo);

                                                        if (currentHourGt != null && previousHourGt != null)
                                                        {
                                                            decimal currentHourGtValue = decimal.Parse(currentHourGt.Gia_Tri);
                                                            decimal previousHourGtValue = decimal.Parse(previousHourGt.Gia_Tri);
                                                            decimal difference = currentHourGtValue - previousHourGtValue;

                                                            <div>@difference</div>

                                                            if (index >= 0)
                                                            {
                                                                ListSum[index].TongGiaTriTieuThu += difference;
                                                                ListSum[index].CountGiaTriTieuThu++;
                                                                ListSum[index].AvrGiaTriTieuThu = Math.Round(ListSum[index].TongGiaTriTieuThu / ListSum[index].CountGiaTriTieuThu, 1);

                                                                if (ListSum[index].MinGiaTriTieuThu > difference)
                                                                {
                                                                    ListSum[index].MinGiaTriTieuThu = difference;
                                                                }
                                                                if (ListSum[index].MaxGiaTriTieuThu < difference)
                                                                {
                                                                    ListSum[index].MaxGiaTriTieuThu = difference;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                ListSum.Add(new ChiTietViewModel
                                                    {
                                                        TenThongSo = tenTramTieuThu,
                                                        TongGiaTriTieuThu = difference,
                                                        MinGiaTriTieuThu = difference,
                                                        MaxGiaTriTieuThu = difference,
                                                        AvrGiaTriTieuThu = difference,
                                                    });
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div>--</div>
                                                        }
                                                    }
                                                }


                                                if (CbThoiGian.Value == 3)
                                                {
                                                    var startDate = StartDate.Date;  // Assuming StartDate is a DateTime property bound to your date picker

                                                    if (cx.ThoiGian.Date == startDate && cx.ThoiGian.Hour == 0 && cx.ThoiGian.Minute == 0)
                                                    {
                                                        <div>--</div>
                                                        // Display "--" for the first hour of the start date
                                                    }
                                                    else
                                                    {
                                                        var currentHourGt = list.FirstOrDefault(x => x.Thoi_Gian.Date == cx.ThoiGian.Date && x.Thoi_Gian.Hour == 00 && x.Thoi_Gian.Minute == 00 && x.Id_ThongSo == item.Id_ThongSo);
                                                        var previousHourGt = list.FirstOrDefault(x => x.Thoi_Gian.Date == cx.ThoiGian.AddDays(-1).Date && x.Thoi_Gian.Hour == 00 && x.Thoi_Gian.Minute == 00 && x.Id_ThongSo == item.Id_ThongSo);

                                                        if (currentHourGt != null && previousHourGt != null)
                                                        {
                                                            decimal currentHourGtValue = decimal.Parse(currentHourGt.Gia_Tri);
                                                            decimal previousHourGtValue = decimal.Parse(previousHourGt.Gia_Tri);
                                                            decimal difference = currentHourGtValue - previousHourGtValue;

                                                            <div>@difference</div>

                                                            if (index >= 0)
                                                            {
                                                                ListSum[index].TongGiaTriTieuThu += difference;
                                                                ListSum[index].CountGiaTriTieuThu++;
                                                                ListSum[index].AvrGiaTriTieuThu = Math.Round(ListSum[index].TongGiaTriTieuThu / ListSum[index].CountGiaTriTieuThu, 1);

                                                                if (ListSum[index].MinGiaTriTieuThu > difference)
                                                                {
                                                                    ListSum[index].MinGiaTriTieuThu = difference;
                                                                }
                                                                if (ListSum[index].MaxGiaTriTieuThu < difference)
                                                                {
                                                                    ListSum[index].MaxGiaTriTieuThu = difference;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                ListSum.Add(new ChiTietViewModel
                                                    {
                                                        TenThongSo = tenTramTieuThu,
                                                        TongGiaTriTieuThu = difference,
                                                        MinGiaTriTieuThu = difference,
                                                        MaxGiaTriTieuThu = difference,
                                                        AvrGiaTriTieuThu = difference,
                                                    });
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div>--</div>
                                                        }
                                                    }
                                                }




                                            }
                                        </Template>
                                    </GridColumn>

                                }
                                else
                                {
                                    string tenTramTieuThu = list.Key + item.TenThongSo + "Tiêu thụ";
                                    string tenTramThongSo = list.Key + item.TenThongSo;
                                    int index = ListSum.FindIndex(x => x.TenThongSo == tenTramThongSo);
                                    if (index >= 0)
                                    {
                                        ListSum[index].MaxGiaTriTieuThu = -1;
                                        ListSum[index].MinGiaTriTieuThu = -1;
                                        ListSum[index].AvrGiaTriTieuThu = -1;

                                    }
                                }
                            }



                        </GridColumns>
                    </GridColumn>
                }
            }
        </GridColumns>
        <GridAggregates>
            <GridAggregate>
                <GridAggregateColumns>
                    <GridAggregateColumn Field="TT" Type="AggregateType.Custom">
                        <FooterTemplate>
                            @{
                                //var listTram = ListNhatKyNgay.GroupBy(x => x.TenTram).Distinct();
                                //foreach (var item in items)
                                //{
                                //    string tenTramThongSo = list.Key + item.TenThongSo;
                                //    int index = ListSum.FindIndex(x => x.TenThongSo == tenTramThongSo);
                                //}


                                <table class="table">
                                    <tr>
                                        <td style="width: 280px; min-width: 280px"> TB </td>
                                        @foreach (var item in ListSum)
                                        {
                                            <td style="width: 150px; min-width: 150px;">@item.AvrGiaTriThongSo</td>
                                            @if (item.AvrGiaTriTieuThu != -1)
                                            {
                                                <td style="width: 150px; min-width: 150px;text-align:center">@item.AvrGiaTriTieuThu</td>
                                            }
                                        }
                                    </tr>
                                    <tr>
                                        <td style="width: 280px; min-width: 280px "> TT </td>
                                        @foreach (var item in ListSum)
                                        {
                                            <td style="width: 150px; min-width: 150px;">@item.MinGiaTriThongSo</td>
                                            @if (item.MinGiaTriTieuThu != -1)
                                            {
                                                <td style="width: 150px; min-width: 150px;text-align:center;">@item.MinGiaTriTieuThu</td>
                                            }
                                        }
                                    </tr>
                                    <tr>
                                        <td style="width: 280px; min-width: 280px"> TĐ </td>
                                        @foreach (var item in ListSum)
                                        {
                                            <td style="width: 150px; min-width: 150px;">@item.MaxGiaTriThongSo</td>
                                            @if (item.MaxGiaTriTieuThu != -1)
                                            {
                                                <td style="width: 150px; min-width: 150px;text-align:center;">@item.MaxGiaTriTieuThu</td>
                                            }
                                        }
                                    </tr>
                                    <tr>
                                        <td> Tổng </td>
                                        @foreach (var item in ListSum)
                                        {
                                            <td style="width: 150px; min-width: 150px">_</td>
                                            @if (item.TongGiaTriTieuThu > 0)
                                            {
                                                <td style="width: 150px; min-width: 150px;text-align:center">@item.TongGiaTriTieuThu</td>
                                            }
                                        }
                                    </tr>
                                </table>
                                ListSum = new List<ChiTietViewModel>();
                            }

                        </FooterTemplate>
                    </GridAggregateColumn>
                </GridAggregateColumns>
            </GridAggregate>
        </GridAggregates>



    </SfGrid>

</BodyCard>
@code
{
    public async Task onXuatExcel()
    {

        int[] Id_ChiNhanh = CbChiNhanh.Value ?? new int[0];
        int[] Id_Tram = CbTram.Value ?? new int[0];
        int[] Id_ThongSo = CbThongSo.Value ?? new int[0];
        int cbThoiGianValue = CbThoiGian.Value;

        urlFile = ExcelExportThang.BaoCaoTraCuu(Id_ChiNhanh, Id_Tram, Id_ThongSo, StartDate.Date, EndDate.Date, cbThoiGianValue);
        dowloadFile();
    }

    public void dowloadFile()
    {
        IJSRuntime.InvokeVoidAsync("open", urlFile);
    }
}



