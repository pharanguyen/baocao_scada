@page "/su-co-scada"
@using DAO.Models.DanhMuc.SuCoOngVo
@using ERPProject.Shared.Combobox
@using Syncfusion.Blazor.Charts;
@using Syncfusion.Blazor.Grids;
@using Syncfusion.Blazor.Layouts;
@using Syncfusion.Blazor.DropDowns;
@using Syncfusion.Blazor.Inputs;
@using Syncfusion.Blazor.Buttons;
@inherits Tong_hop_nguyen_nhanBase

<style>
    .form-section {
        margin-bottom: 1rem;
    }

        .form-section h5 {
            margin-bottom: 1rem;
            font-weight: 600;
            color: #333;
        }

    .btn-spacing > * {
        margin-right: 8px;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 0 8px rgba(0,0,0,0.05);
    }

    .e-control.e-textbox,
    .e-input-group {
        height: 38px;
    }
</style>

<div class="card m-3 p-3 form-section">
    <h5>Thông tin sự cố SCADA</h5>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label>Chi nhánh</label>
            <CbChiNhanh @ref="CbChiNhanhNhap" Width="100%" ValueChanged="OnChiNhanhNhapChanged" />
        </div>
        <div class="col-12 col-md-4">
            <label>Đồng hồ khối</label>
            <DhkCombo @ref="CbDhk" Width="100%" PopupWidth="300px" @bind-Value="SelectedDhk" DataSource="listDhkTheoChiNhanhNhap" />
        </div>
        <div class="col-12 col-md-4">
            <label>Tên TQL</label>
            <SfTextBox @bind-Value="TenTQL" Placeholder="Tên tổ quản lý" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Thông tin sự cố</label>
            <SfTextBox @bind-Value="ThongTinSuCo" Placeholder="Mô tả sự cố" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Ngày xảy ra</label>
            <SfDatePicker @bind-Value="NgayXayRa" Format="dd/MM/yyyy" Width="100%" />
        </div>
        <div class="col-12 col-md-4">
            <label>Ngày kiểm tra</label>
            <SfDatePicker @bind-Value="NgayKiemTra" Format="dd/MM/yyyy" Width="100%" />
        </div>
        <div class="col-12 col-md-4">
            <label>Ngày hoàn thành</label>
            <SfDatePicker @bind-Value="NgayHoanThanh" Format="dd/MM/yyyy" Width="100%" />
        </div>
        <div class="col-12 col-md-4">
            <label>Xử lý QL địa bàn</label>
            <SfTextBox @bind-Value="XuLyQLDiaBan" Placeholder="Người xử lý" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Xử lý CNTT</label>
            <SfTextBox @bind-Value="XuLyCNTT" Placeholder="Người xử lý" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Xử lý XNDH</label>
            <SfTextBox @bind-Value="XuLyXNDH" Placeholder="Người xử lý" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Kết quả</label>
            <SfTextBox @bind-Value="KetQua" Placeholder="Kết quả xử lý" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Nguyên nhân</label>
            <SfTextBox @bind-Value="NguyenNhan" Placeholder="Nguyên nhân sự cố" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Chỉ số ĐH</label>
            <SfTextBox @bind-Value="ChiSo_DH" Placeholder="Chỉ số đồng hồ" FloatLabelType="FloatLabelType.Auto" />
        </div>
        <div class="col-12 col-md-4">
            <label>Chỉ số HT</label>
            <SfTextBox @bind-Value="ChiSo_HT" Placeholder="Chỉ số hệ thống" FloatLabelType="FloatLabelType.Auto" />
        </div>
    </div>
    <div class="mt-3 d-flex justify-content-end btn-spacing">
        <SfButton CssClass="e-primary" @onclick="OnSave" IconCss="e-icons e-save">Lưu</SfButton>
        <SfButton CssClass="e-danger" @onclick="ClearFields" IconCss="e-icons e-cancel">Hủy</SfButton>
    </div>
</div>

<div class="card m-3 p-3 form-section">
    <h5>Lọc dữ liệu</h5>
    <div class="row g-3">
        <div class="col-12 col-md-3">
            <label>Chi nhánh lọc</label>
            <CbChiNhanh @ref="CbChiNhanhLoc" Width="100%" ValueChanged="OnChiNhanhLocChanged" />
        </div>
        <div class="col-12 col-md-3">
            <label>Đồng hồ khối lọc</label>
            <CbMultiDHK @ref="CbDhkMulti" Width="100%" PopupWidth="300px" Value="@SelectedDhkList" OnDataSent="ValueChangeHandlerDhk" DataSource="listDhkTheoChiNhanhLoc" />
        </div>
        <div class="col-12 col-md-3">
            <label>Từ ngày</label>
            <SfDatePicker @bind-Value="TuNgay" Format="dd/MM/yyyy" Width="100%" />
        </div>
        <div class="col-12 col-md-3">
            <label>Đến ngày</label>
            <SfDatePicker @bind-Value="DenNgay" Format="dd/MM/yyyy" Width="100%" />
        </div>
        <div class="col-12 d-flex justify-content-start btn-spacing mt-2">
            <SfButton CssClass="e-success" IconCss="e-icons e-search" @onclick="LoadData">Xem dữ liệu</SfButton>
            <SfButton CssClass="e-info" IconCss="e-icons e-export-excel" @onclick="onXuatExcel">Xuất Excel</SfButton>
        </div>
    </div>
</div>

<SfGrid @ref="gdv" DataSource="@listThongSoTramLoc" AllowPaging="true" PageSettings="@(new() { PageSize = 10 })" AllowExcelExport="true">
    <GridColumns>
        <GridColumn Field="Id" HeaderText="ID" Width="80" TextAlign="TextAlign.Center" />
        <GridColumn Field="ten_dhk" HeaderText="Đồng hồ khối" />
        <GridColumn Field="TenTQL" HeaderText="TQL" />
        <GridColumn Field="ThongTinSuCo" HeaderText="Thông tin sự cố" />
        <GridColumn Field="NgayXayRa" HeaderText="Ngày xảy ra" Format="dd/MM/yyyy" />
        <GridColumn Field="NgayKiemTra" HeaderText="Ngày kiểm tra" Format="dd/MM/yyyy" />
        <GridColumn HeaderText="Đơn vị Khắc phục" TextAlign="TextAlign.Center">
            <GridColumns>
                <GridColumn Field="XuLy_QLDiaBan" HeaderText="QL địa bàn" />
                <GridColumn Field="XuLy_CNTT" HeaderText="CNTT" />
                <GridColumn Field="XuLy_XNDH" HeaderText="XNDH" />
            </GridColumns>
        </GridColumn>
        <GridColumn Field="NgayHoanThanh" HeaderText="Hoàn thành" Format="dd/MM/yyyy" />
        <GridColumn Field="KetQua" HeaderText="Kết quả" />
        <GridColumn Field="NguyenNhan" HeaderText="Nguyên nhân" />
        <GridColumn HeaderText="Dữ liệu sau khắc phục" TextAlign="TextAlign.Center">
            <GridColumns>
                <GridColumn Field="ChiSo_DH" HeaderText="Chỉ số ĐH" />
                <GridColumn Field="ChiSo_HT" HeaderText="Chỉ số HT" />
            </GridColumns>
        </GridColumn>
        <GridColumn HeaderText="Chức năng" Width="150">
            <Template Context="data">
                @{
                    var item = (SuCoScadaViewModel)data;
                }
                <SfButton CssClass="e-flat e-primary" @onclick="() => onCapNhat(item.Id)">Sửa</SfButton>
                <SfButton CssClass="e-flat e-danger ml-2" @onclick="() => onXoa(item.Id)">Xóa</SfButton>
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>