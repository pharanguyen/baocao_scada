@page "/Dm_BcNgay"
@using DAO.Models.DanhMuc
@using DAO.Services.XuatExcel;
@using DAO.ViewModel;
@using ERPProject.Shared.Combobox;

@inherits BcNgayBase
@inject NavigationManager NavigationManager
@inject IJSRuntime IJSRuntime
<style type="text/css">
