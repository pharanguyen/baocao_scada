<BodyCard>
    <SfToolbar>
        <ToolbarItems>
            <div class="row">
                <div class="col">
                    <span class="title">Chọn chi nhánh:</span>
                    <CbMultiChiNhanh @ref="CbChiNhanh" Width="300px" PopupWidth="100%" OnDataSent="ValueChangeHandler"></CbMultiChiNhanh>
                </div>
                <div class="col">
                    <span class="title">Chọn Trạm:</span>
                    <CbMultiTram @ref="CbTram" Width="300px" PopupWidth="100%" Data="prcTrams" OnDataSent="ValueChangeHandler1"></CbMultiTram>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <span class="title">Từ ngày</span>
                    <SfDatePicker TValue="DateTime" @bind-Value="StartDate" Format="dd/MM/yyyy" Width="300px" />
                </div>
                <div class="col">
                    <span class="title">Đến ngày</span>
                    <SfDatePicker TValue="DateTime" @bind-Value="EndDate" Format="dd/MM/yyyy" Width="300px" />
                </div>
            </div>
            <div class="col">
                <ToolbarItem Type="ItemType.Button">
                    <Template>
                        <SfButton CssClass="e-flat" IconCss="icon-loop3" @onclick="onTaiLai">Xem dữ liệu</SfButton>
                    </Template>
                </ToolbarItem>
                <ToolbarItem Type="ItemType.Separator" />
                <ToolbarItem Type="ItemType.Button">
                    <Template>
                        <SfButton CssClass="e-flat e-info" IconCss="icon-file-excel" @onclick="onXuatExcel">Xuất excel</SfButton>
                    </Template>
                </ToolbarItem>
            </div>
        </ToolbarItems>
    </SfToolbar>

    <SfGrid DataSource="@data"
            @ref="gdv"
            AllowPaging="true"
            EditSettings="@editSettings"
            AllowExcelExport="true"
            Toolbar="@Toolbar">

        <GridEvents RowDataBound="@OnRowDataBound"
                    OnActionBegin="@OnActionBegin"
                    TValue="CanhBaoApLucViewModel" />

        <GridPageSettings PageSize="12" />

        <GridColumns>
            <GridColumn HeaderText="" Width="40">
                <Template Context="item">
                    @GetCanhBaoIcon((CanhBaoApLucViewModel)item)
                </Template>
            </GridColumn>
            <GridColumn Field="Id_Tram" HeaderText="Mã Trạm" Width="100" TextAlign="TextAlign.Center" AllowEditing="false" />
            <GridColumn Field="TenTram" HeaderText="Tên Trạm" Width="200" AllowEditing="false" />
            <GridColumn Field="GioPhutGiay" HeaderText="Thời gian" Format="g" Width="180" AllowEditing="false" />
            <GridColumn Field="GiaTri" HeaderText="Áp lực (bar)" Width="150" AllowEditing="false">
                <Template Context="item">
                    <span style="color:@GetGiaTriStyle((CanhBaoApLucViewModel)item)">
                        @(((CanhBaoApLucViewModel)item).GiaTri)
                    </span>
                </Template>
            </GridColumn>


            <GridColumn Field="ApLucMin" HeaderText="Cảnh báo Min" Width="100" Format="N2" TextAlign="TextAlign.Right" AllowEditing="true" />
            <GridColumn Field="ApLucMax" HeaderText="Cảnh báo Max" Width="100" Format="N2" TextAlign="TextAlign.Right" AllowEditing="true" />

        </GridColumns>
    </SfGrid>
</BodyCard>

<LoadingPanel @ref="AppData.loadingPanel" />


