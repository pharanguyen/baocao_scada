    <SfGrid DataSource="@data"
            @ref="gdv"
            AllowPaging="true"
            EditSettings="@editSettings"
            Toolbar="@Toolbar">

        <GridEvents RowDataBound="@OnRowDataBound"
                    OnActionBegin="@OnActionBegin"
                    TValue="CanhBaoTieuThuNgay" />

        <GridPageSettings PageSize="12" />

        <GridColumns>
            <GridColumn HeaderText="" Width="40">
                <Template Context="item">
                    @GetCanhBaoIcon((CanhBaoTieuThuNgay)item)
                </Template>
            </GridColumn>
            <GridColumn Field="IdTram" HeaderText="Mã Trạm" Width="100" TextAlign="TextAlign.Center" IsPrimaryKey="true" AllowEditing="false" />
            <GridColumn Field="TenTram" HeaderText="Tên Trạm" Width="200" AllowEditing="false" />
            <GridColumn Field="MucCanhBao" HeaderText="Mức cảnh báo (m³)" EditType="EditType.NumericEdit" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn Field="TyLeCanhBao" HeaderText="Tỷ lệ cảnh báo (%)" EditType="EditType.NumericEdit" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn Field="LuuLuongTuNgay" HeaderText="Lưu lượng từ ngày" Width="160" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
            <GridColumn Field="LuuLuongDenNgay" HeaderText="Lưu lượng đến ngày" Width="160" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
            <GridColumn Field="TieuThu" HeaderText="Tiêu thụ" Width="140" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
        </GridColumns>
    </SfGrid>

</BodyCard>
<LoadingPanel @ref="AppData.loadingPanel" />

